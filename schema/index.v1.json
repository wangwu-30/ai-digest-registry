{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:personal-ai-daily:schema:index:v1",
  "title": "Personal AI Daily — site index (index.v1)",
  "description": "BASE/index.json (SKILL §4.6). Closed objects; x-* scalars only; every string capped. Validate with format assertion ON.",
  "type": "object",
  "required": [
    "schema_version",
    "schema",
    "curator",
    "topics",
    "language",
    "timezone",
    "latest",
    "dates"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^https?://[^\\s/?#]+\\.[^\\s/?#]+(/[^\\s]*)?$",
      "description": "URL of a copy of this schema with matching $id and canonical hash (SKILL §4.3)"
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$",
      "description": "digest schema version of the newest issue"
    },
    "schema": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^https?://[^\\s/?#]+\\.[^\\s/?#]+(/[^\\s]*)?$",
      "description": "URL of a copy of that digest schema (SKILL §4.3)"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "curator": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s/?#]+\\.[^\\s/?#]+(/[^\\s]*)?$",
          "maxLength": 2048
        }
      },
      "propertyNames": {
        "anyOf": [
          {
            "enum": [
              "name",
              "url"
            ]
          },
          {
            "pattern": "^x-[a-z0-9][a-z0-9_-]{0,39}$"
          }
        ]
      },
      "patternProperties": {
        "^x-": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 40
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z]{4})?(-([A-Z]{2}|\\d{3}))?$",
      "maxLength": 35
    },
    "timezone": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+){0,2}$|^UTC$",
      "description": "IANA zone of the issue dates"
    },
    "update": {
      "type": "string",
      "maxLength": 200,
      "description": "human note on cadence, e.g. 'as soon as each issue is ready (no fixed time)'"
    },
    "latest": {
      "type": "string",
      "maxLength": 10,
      "format": "date",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "sources_opml": {
      "type": "string",
      "description": "URL of sources.opml; present only when the curator opted in (site.publish_sources: true). Optional; registries must not require it",
      "maxLength": 2048,
      "pattern": "^https?://[^\\s/?#]+\\.[^\\s/?#]+(/[^\\s]*)?$"
    },
    "build_report": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://[^\\s/?#]+\\.[^\\s/?#]+(/[^\\s]*)?$"
    },
    "dates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "maxLength": 10,
            "format": "date",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "generated_at": {
            "type": "string",
            "maxLength": 40,
            "format": "date-time",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d+)?)?([+-]([01]\\d|2[0-3]):[0-5]\\d|Z)$"
          },
          "published_at": {
            "type": "string",
            "maxLength": 40,
            "format": "date-time",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d+)?)?([+-]([01]\\d|2[0-3]):[0-5]\\d|Z)$"
          },
          "html": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https?://[^\\s/?#]+\\.[^\\s/?#]+(/[^\\s]*)?$"
          },
          "md": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https?://[^\\s/?#]+\\.[^\\s/?#]+(/[^\\s]*)?$"
          },
          "json": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https?://[^\\s/?#]+\\.[^\\s/?#]+(/[^\\s]*)?$"
          }
        },
        "required": [
          "date",
          "generated_at",
          "html",
          "md",
          "json"
        ],
        "propertyNames": {
          "anyOf": [
            {
              "enum": [
                "date",
                "generated_at",
                "published_at",
                "html",
                "md",
                "json"
              ]
            },
            {
              "pattern": "^x-[a-z0-9][a-z0-9_-]{0,39}$"
            }
          ]
        },
        "patternProperties": {
          "^x-": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 200
          }
        }
      },
      "description": "newest first, one per published issue"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "maxLength": 10,
            "format": "date",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "corrected_at": {
            "type": "string",
            "maxLength": 40,
            "format": "date-time",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d+)?)?([+-]([01]\\d|2[0-3]):[0-5]\\d|Z)$"
          },
          "commit": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[0-9a-f]{7,64}$"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "maxLength": 80,
                  "minLength": 1
                },
                "from": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200
                },
                "to": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200
                }
              },
              "required": [
                "field",
                "from",
                "to"
              ],
              "propertyNames": {
                "anyOf": [
                  {
                    "enum": [
                      "field",
                      "from",
                      "to"
                    ]
                  },
                  {
                    "pattern": "^x-[a-z0-9][a-z0-9_-]{0,39}$"
                  }
                ]
              },
              "patternProperties": {
                "^x-": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ],
                  "maxLength": 200
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          }
        },
        "required": [
          "date",
          "corrected_at",
          "changes",
          "reason",
          "evidence"
        ],
        "propertyNames": {
          "anyOf": [
            {
              "enum": [
                "date",
                "corrected_at",
                "commit",
                "changes",
                "reason",
                "evidence"
              ]
            },
            {
              "pattern": "^x-[a-z0-9][a-z0-9_-]{0,39}$"
            }
          ]
        },
        "patternProperties": {
          "^x-": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 200
          }
        }
      },
      "description": "public log of corrected published values (SKILL §2.7)"
    }
  },
  "propertyNames": {
    "anyOf": [
      {
        "enum": [
          "$schema",
          "schema_version",
          "schema",
          "title",
          "curator",
          "topics",
          "language",
          "timezone",
          "update",
          "latest",
          "sources_opml",
          "build_report",
          "dates",
          "corrections"
        ]
      },
      {
        "pattern": "^x-[a-z0-9][a-z0-9_-]{0,39}$"
      }
    ]
  },
  "patternProperties": {
    "^x-": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ],
      "maxLength": 200
    }
  }
}